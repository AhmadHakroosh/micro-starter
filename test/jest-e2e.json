{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@config(|/.*)$": "<rootDir>/src/config$1",
    "^@health(|/.*)$": "<rootDir>/src/health$1",
    "^@logger(|/.*)$": "<rootDir>/src/logger$1",
    "^@kafka(|/.*)$": "<rootDir>/src/kafka$1"
  }
}